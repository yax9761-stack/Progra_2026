Algoritmo Calculadora_Simple
	Definir num1, num2, totalSuma, totalResta, totalMulti, totalDivision como Entero
	Escribir "Dime tu primer numero"
	leer num1
	Escribir "Dime tu segundo numero"
	leer num2
	totalSuma <- num1 + num2
	totalResta <- num1 - num2
	totalMulti <- num1 * num2
	totalDivision <- num1 / num2
	Escribir "El total de la suma es de: ", totalSuma
	Escribir "El total de la resta es de: ", totalResta
	Escribir "El total de la multiplicacion es de: ", totalMulti
	Escribir "El total de la division es de: ", totalDivision
FinAlgoritmo
